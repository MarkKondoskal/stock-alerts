# Copy this file to .env and fill in the values. Never commit .env.
DASHBOARD_PASSWORD=replace-with-a-long-unique-password
GITHUB_TOKEN=replace-with-your-fine-grained-token
GITHUB_REPOSITORY=your-github-username/stock-alerts-main
GITHUB_BRANCH=main
# Optional: Discord webhook for the dashboard's test function
DISCORD_STOCK_WEBHOOK=

# Required for private account and performance access.
GITHUB_DATA_REPOSITORY=your-github-username/stock-alerts-private-data
GITHUB_DATA_BRANCH=main
# Optional: server-side FRED/ALFRED key for prior and actual economic readings.
FRED_API_KEY=
