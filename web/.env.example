# Copy this file to .env and fill in the values. Never commit .env.
DASHBOARD_PASSWORD=replace-with-a-long-unique-password
GITHUB_TOKEN=replace-with-your-fine-grained-token
GITHUB_REPOSITORY=your-github-username/stock-alerts-main
GITHUB_BRANCH=main
# Optional: Discord webhook for the dashboard's test function
DISCORD_STOCK_WEBHOOK=
